# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=retrieval-ranking-cascade
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run retrieval-ranking-cascade generate-api-key
APP_API_KEY_SHA256=
# Digests of keys that additionally hold the admin scope (reindex, bundle swap).
# An admin key must also be listed in APP_API_KEY_SHA256.
APP_ADMIN_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# --- cascade serving ---
# Directory holding manifest.json plus the five artifact files it hashes.
APP_BUNDLE_DIR=var/bundle
# faiss OpenMP threads. Keep at 1 for per-request serving; raise for batch jobs.
APP_FAISS_THREADS=1
# Worker threads for the synchronous request handlers.
APP_SERVER_THREADS=8
APP_DEFAULT_K=20
APP_MAX_K=100
APP_CANDIDATE_K=500
APP_MAX_CANDIDATE_K=2000
# Candidates the LambdaMART stage scores, out of the retrieved candidate_k.
APP_RERANK_DEPTH=100
APP_DEFAULT_EF_SEARCH=768
APP_MAX_EF_SEARCH=2048
# Refuse a request whose candidate_k * sqrt(ef_search) exceeds this cost.
APP_MAX_QUERY_COST=40000
APP_REQUEST_BUDGET_MS=50
APP_RETRIEVAL_BUDGET_MS=20
APP_RANKING_BUDGET_MS=20
APP_MMR_LAMBDA=0.7
APP_MAX_PER_CATEGORY=5
APP_CANARY_INTERVAL_SECONDS=30
APP_CANARY_SAMPLE_SIZE=32
APP_CANARY_K=100
APP_CANARY_THRESHOLD=0.9
APP_FEEDBACK_RATE_LIMIT_PER_SECOND=2
APP_FEEDBACK_RATE_LIMIT_BURST=20
# The per-source bucket above cannot bound a client, because the client picks `source`. The bucket
# keyed on the API key runs at this multiple of that rate and burst.
APP_FEEDBACK_CLIENT_RATE_MULTIPLIER=4
APP_AUDIT_LOG_PATH=var/audit/admin.jsonl

APP_DATA_DIR=var
# Directories /v1/admin/bundle may load a bundle from (defaults to APP_DATA_DIR). The live
# APP_BUNDLE_DIR is always allowed, so a reload in place works wherever it lives.
APP_BUNDLE_ROOT=var
